# =============================================================================
# EvoAgent configuration
#
# Copy this file to `.env` and fill in the values you need. Every variable is
# optional except OPENAI_API_KEY. Uncomment optional settings only after
# replacing placeholders; defaults are defined in the code.
# =============================================================================

# --- LLM ----------------------------------------------------------------------
# Required. Any OpenAI-compatible endpoint (OpenAI, Azure, self-hosted, etc.).
OPENAI_API_KEY=<your-api-key>
# OPENAI_API_BASE=<your-openai-api-base>
# Optional second endpoint used by skill matcher / history compressor. Falls
# back to OPENAI_API_BASE when unset.
# OPENAI_API_BASE_SECONDARY=<your-openai-api-base-secondary>
# Optional third endpoint for vision-capable models. Falls back to
# OPENAI_API_BASE when unset.
# OPENAI_API_BASE_VISION=<your-openai-api-base-vision>

# Main backbone model
# MODEL=<your-model>
# Light model used by vision tools (image_understanding, image_replication)
# MODEL_VISION=<your-model-vision>
# Light model used by history compression and the skill matcher's LLM stage
# COMPRESSION_MODEL=<your-compression-model>

# Optional embedding model / endpoint. Defaults to text-embedding-3-small on
# OPENAI_API_BASE_SECONDARY.
# EMBEDDING_MODEL=<your-embedding-model>
# EMBEDDING_API_BASE=<your-embedding-api-base>

# Optional outbound HTTP proxy (e.g. http://proxy.example.com:8118)
# PROXY_SERVER=<your-proxy-server>

# --- Agent runtime ------------------------------------------------------------
# LLM_MAX_RETRIES=<your-llm-max-retries>
# LLM_RETRY_DELAY=<your-llm-retry-delay>
# ENABLE_METRICS=<your-enable-metrics>
# MAX_STEPS=<your-max-steps>

# History compression
# MAX_HISTORY_TOKENS=<your-max-history-tokens>
# COMPRESSION_THRESHOLD=<your-compression-threshold>
# COMPRESSION_LEVEL=<your-compression-level>
# MIN_MESSAGES_TO_KEEP=<your-min-messages-to-keep>

# Skill matcher threshold for stage-2 embedding match (0.0 ~ 1.0)
# SKILL_MATCH_EMBEDDING_THRESHOLD=<your-skill-match-embedding-threshold>

# --- Plugins ------------------------------------------------------------------
# Comma-separated list of plugins loaded into every new agent session.
# Default is a conservative whitelist: web retrieval only, no code execution
# and no image tools (image_* plugins also require DOUBAO_API_KEY).
#
# Use "all" to load everything registered in core/plugins/__init__.py — this
# opts into `execute_code`, which runs bash / Python in the user's workspace.
# Only use "all" for trusted, single-tenant research deployments.
#
# Available plugins (see core/plugins/__init__.py for the full list):
#   web_search, fetch_url, execute_code, image_generation, image_editing,
#   image_understanding, image_replication, reddit_scraper
# DEFAULT_PLUGINS=<your-default-plugins>

# --- External services (optional) --------------------------------------------
# Doubao (火山引擎) for image_generation / image_editing
# DOUBAO_API_KEY=<your-doubao-api-key>
# DOUBAO_MODEL=<your-doubao-model>

# Tavily for the `websearch` plugin
# TAVILY_API_KEY=<your-tavily-api-key>

# --- Storage ------------------------------------------------------------------
# Two mutually-exclusive deployment modes, picked by whether MINIO_ENDPOINT is set:
#
#   LOCAL mode (MINIO_ENDPOINT empty)
#     Storage : LocalFSBackend on `{WORKSPACE_ROOT}/{user_id}/`
#     Sandbox : plain subprocess scoped to that directory (single-tenant /
#               trusted-host only — no kernel-level isolation)
#
#   MINIO mode (MINIO_ENDPOINT set)
#     Storage : MinIOSDKBackend, all keys under `{user_id}/...` in the bucket
#     Sandbox : ephemeral container that mounts the bucket via s3fs
#
# The two modes are exclusive; mixed configurations (e.g. MinIO storage + local
# sandbox) fail at startup. Switch the whole deployment by setting/unsetting
# MINIO_ENDPOINT — no other knob to flip.

# Per-user workspace root (LOCAL mode only). Each user gets
# `{WORKSPACE_ROOT}/{user_id}/` created on first interaction, containing their
# prompts / skills / sessions / images.
# WORKSPACE_ROOT=<your-workspace-root>

# MinIO connection — leave MINIO_ENDPOINT empty to stay in LOCAL mode.
# When set, the server uses MinIO for all workspace data and refuses to start
# without MINIO_ACCESS_KEY / MINIO_SECRET_KEY (no silent fallback).
#
# MINIO_ENDPOINT=<your-minio-endpoint>
# MINIO_ACCESS_KEY=<your-minio-access-key>
# MINIO_SECRET_KEY=<your-minio-secret-key>
# MINIO_BUCKET=<your-minio-bucket>

# --- Sandbox (MINIO mode only) ------------------------------------------------
# Backend used to spin up the per-invocation sandbox container.
#   docker  Docker daemon (default; first-version target). Server connects via
#           DOCKER_HOST or /var/run/docker.sock and creates a one-shot container
#           per execute_code call. Auto-cleans on exit.
#   k8s     K8s Job (M5 — not yet implemented; will fail at startup).
# SANDBOX_BACKEND=<your-sandbox-backend>

# Where the Docker daemon lives. Empty = local /var/run/docker.sock. Use
# `ssh://user@host` to drive a remote daemon over SSH (the SDK reuses your
# ssh-agent / ~/.ssh/config), or `tcp://host:2376` for a TCP socket.
# DOCKER_HOST=<your-docker-host>

# Image tag for the sandbox container. Built from `deploy/sandbox-image/`
# (added in M2). Pre-pull to the daemon host or push to a private registry —
# do not rely on every cold start hitting docker.io.
# SANDBOX_IMAGE=<your-sandbox-image>

# Container network mode. `host` is fastest when MinIO and the daemon are on
# the same machine (~3 ms RTT); switch to a custom bridge + NetworkPolicy for
# multi-tenant isolation.
# SANDBOX_NETWORK=<your-sandbox-network>

# Per-invocation wall-clock cap (seconds). The sandbox is killed past this.
# SANDBOX_TIMEOUT_S=<your-sandbox-timeout-s>

# Reserved for M5 (K8s Job mode); ignored when SANDBOX_BACKEND=docker.
# KUBE_NAMESPACE=<your-kube-namespace>

# Template directories — source-of-truth for first-time initialization.
# When a user's workspace is created for the first time, the server copies
# prompt templates and built-in skills from these two directories into
# `{WORKSPACE_ROOT}/{user_id}/prompts/` and `.../skills/` respectively.
# Sync policy:
#   - SOUL.md is force-overwritten on every startup (agent identity is owned
#     by the platform, not the user)
#   - USER.md / MEMORY.md / SESSION_UPDATE.md / SKILL_EXTRACT.md / SKILL_MATCH.md
#     are only copied when missing, so user data is never clobbered
#   - Built-in skills are re-synced when source content changes (fingerprint
#     via `.meta/sync_version` under the user's workspace)
# After that first sync the server only reads the *per-user* copies — these
# two paths are no longer touched at runtime.
#
# Override only in advanced scenarios (custom template packs per tenant,
# pinned test fixtures, or a non-standard deployment layout that moves the
# repo's own config trees). Do not point at a path outside the repo unless
# you know why.
# DEFAULT_PROMPTS_DIR=<your-default-prompts-dir>
# DEFAULT_SKILLS_DIR=<your-default-skills-dir>

# --- Server -------------------------------------------------------------------
# Used when the server needs to advertise its own URL back to clients.
# SERVER_BASE_URL=<your-server-base-url>

# CORS allow-list. Comma-separated origins. Leave unset for localhost-only
# defaults. Use "*" to allow any origin (browsers will then ignore credentials).
# Example: ALLOWED_ORIGINS=https://example.com,https://demo.example.com
# ALLOWED_ORIGINS=<your-allowed-origins>

# --- execute_code sandbox -----------------------------------------------------
# allow | deny — whether the sandbox can reach the outside network. Default
# allows `pip install` and web calls; set to `deny` for airtight isolation.
# Honored in MINIO mode (RemoteDockerBackend); ignored in LOCAL mode (the
# subprocess inherits the host's network).
# EXECUTE_CODE_NETWORK=<your-execute-code-network>

# Memory cap (MB) for the MINIO-mode container (`docker run --memory`). Set
# to 0 to disable. Ignored in LOCAL mode.
# EXECUTE_CODE_MEMORY_MB=<your-execute-code-memory-mb>

# --- Rate limiting (optional) -------------------------------------------------
# When set, applies a global per-client-IP limit to every endpoint. Requires the
# `slowapi` package to be installed (not in requirements.txt by default):
#   pip install slowapi
# Examples: "20/minute", "1000/day", "5/second".
# RATE_LIMIT=<your-rate-limit>

# --- Demo auth (single-tenant research deployments only) ----------------------
# Salt for the SHA-256 password hasher in `app/api/routers/auth.py`. Override
# before any non-local deployment. The module logs a warning if this is unset.
# AUTH_SALT=<your-auth-salt>

# --- Logging ------------------------------------------------------------------
# LOG_JSON=1 emits single-line JSON on stderr (for log aggregators); default is
# coloured human-readable output.
# LOG_JSON=<your-log-json>
# Stderr / file sink levels. Defaults: INFO to stderr, DEBUG to rotated file.
# LOG_LEVEL=<your-log-level>
# LOG_FILE_LEVEL=<your-log-file-level>

# Provider bases include the API base path; full URLs override image routes.
# DOUBAO_API_BASE=<your-image-api-base-url>
# DOUBAO_GENERATIONS_URL=<your-image-generation-url>
# DOUBAO_EDITS_URL=<your-image-edit-url>
# APIFY_API_BASE=<your-scraper-api-base-url>
# APIFY_ACTOR_ID=<your-scraper-actor-id>
# APIFY_API_TOKEN=<your-scraper-api-token>
